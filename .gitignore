# ==============================================================================
# The Lenny Growth Assistant - .gitignore
# ==============================================================================

# Environment variables & secrets (CRITICAL: Never commit real keys or secrets)
.env
.env.local
.env.*.local
*.env

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Testing & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml

# Node.js & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Frontend Build Outputs
dist/
dist-ssr/
*.local
out/
.next/
storybook-static/

# IDE & Editor Specific Files
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Database & Local Storage
*.sqlite
*.sqlite3
*.db
pgdata/
docker_data/

# Logs & Runtime Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw and Processed Transcripts / Temporary Ingestion Cache
data/raw/
data/cache/
data/embeddings/
!data/raw/.gitkeep
!data/samples/

# Temporary and Scratch Directories
tmp/
temp/
scratch/
