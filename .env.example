# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template
# Copy this file to '.env' and populate with your actual configuration values.
# NEVER commit the active '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Model Provider & Agent Selection
# ------------------------------------------------------------------------------
# Available providers: "ollama", "anthropic", "openai"
DEFAULT_MODEL_PROVIDER=ollama

# Cloud LLM: Anthropic Claude (Recommended for complex reasoning & artifact generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloud LLM: OpenAI (Alternative Cloud Provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Local LLM: Ollama (For offline / zero-cost local execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_REQUEST_TIMEOUT=120

# ------------------------------------------------------------------------------
# 3. PostgreSQL & pgvector Database Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=lenny_growth_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_here@localhost:5432/lenny_growth_db

# ------------------------------------------------------------------------------
# 4. Retrieval-Augmented Generation (RAG) & Ingestion
# ------------------------------------------------------------------------------
# Embedding provider: "ollama" (local nomic-embed-text) or "openai" (text-embedding-3-small)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
RAG_TOP_K_CHUNKS=5
RAG_SIMILARITY_THRESHOLD=0.70
TRANSCRIPT_DATA_DIR=./data/raw

# ------------------------------------------------------------------------------
# 5. Agent & Artifact Generation Limits
# ------------------------------------------------------------------------------
ESSAY_TARGET_WORD_COUNT=1250
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60